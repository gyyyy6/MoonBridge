# Build output
# The prebuilt wheel IS committed: it is what lets a pure-Python developer run
# the README Quick Start from a fresh clone with no MoonBit toolchain. Every
# other file under dist/ (staged project, throwaway venv) is a build artifact.
_build/
target/
dist/*
!dist/*.whl
build/

# MoonBit package cache
.mooncakes/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
*.so
*.pyd
*.dll

# JS
node_modules/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Generated interface dumps (moon info)
*.generated.mbti

# Corpus working directory created by scripts/corpus.sh
_corpus/
_gen/
_scratch/
_gen*/
