//! The Python support modules every generated binding imports.
//!
//! Stubs are typed against these files, so they are part of the generated
//! contract, not an implementation detail of the loader. Keeping them as
//! templates (rather than checked-in `.py` files) means the wheel, the stubs
//! and the runtime cannot drift apart: one run writes all of them.
//!
//! Everything here is type-checked by `mypy --strict` in CI together with the
//! stubs. That is why the code annotates rather than guesses: the runtime is
//! the one place in the generated package where a lie would only show up as a
//! confusing failure at a user's call site.

///|
/// File name of the runtime module inside the generated package.
pub fn runtime_filename() -> String {
  "_runtime.py"
}

///|
/// File name of the codec module inside the generated package.
pub fn codec_filename() -> String {
  "_codec.py"
}

///|
/// File name of the wasmtime host inside the generated package.
pub fn host_filename() -> String {
  "_wasmtime.py"
}

///|
/// The binary codec. Mirrors `src/abi/codec.mbt` tag for tag; the golden
/// vectors in that package's tests are the same bytes this module produces.
pub fn render_codec() -> String {
  let text =
    #|"""Binary codec for the MoonBridge wire format.
    #|
    #|Generated by MoonBridge. Do not edit by hand.
    #|
    #|The format is one tag byte, fixed-width primitives, varint lengths, little
    #|endian, nothing aligned or padded. `src/abi/codec.mbt` is the other half of
    #|this file: the golden vectors in its tests are the bytes produced here.
    #|"""
    #|
    #|from __future__ import annotations
    #|
    #|import struct
    #|from typing import Any, Final, Sequence
    #|
    #|TAG_NULL: Final = 0
    #|TAG_TRUE: Final = 1
    #|TAG_FALSE: Final = 2
    #|TAG_INT: Final = 3
    #|TAG_DOUBLE: Final = 4
    #|TAG_STR: Final = 5
    #|TAG_BYTES: Final = 6
    #|TAG_LIST: Final = 7
    #|TAG_MAP: Final = 8
    #|TAG_HANDLE: Final = 9
    #|
    #|STATUS_OK: Final = 0
    #|STATUS_FAILED: Final = 1
    #|STATUS_PANIC: Final = 2
    #|
    #|
    #|class Handle(int):
    #|    """The id of a value that stayed in the MoonBit heap.
    #|
    #|    A `Handle` is an `int` so it costs nothing to carry around, but it is a
    #|    distinct type so the encoder can tell it apart from a number: `Json` and
    #|    `3` must not travel under the same tag.
    #|    """
    #|
    #|    __slots__ = ()
    #|
    #|    def __repr__(self) -> str:
    #|        return f"Handle({int(self)})"
    #|
    #|
    #|class DecodeError(ValueError):
    #|    """A payload that does not match the wire format."""
    #|
    #|
    #|def _varint(out: bytearray, value: int) -> None:
    #|    if value < 0:
    #|        raise ValueError("negative length")
    #|    while value >= 0x80:
    #|        out.append((value & 0x7F) | 0x80)
    #|        value >>= 7
    #|    out.append(value)
    #|
    #|
    #|def dump(value: object) -> bytes:
    #|    """Encodes one value."""
    #|    out = bytearray()
    #|    _dump(value, out)
    #|    return bytes(out)
    #|
    #|
    #|def dump_args(args: Sequence[object]) -> bytes:
    #|    """Encodes a call's argument list as one list value."""
    #|    out = bytearray()
    #|    out.append(TAG_LIST)
    #|    _varint(out, len(args))
    #|    for item in args:
    #|        _dump(item, out)
    #|    return bytes(out)
    #|
    #|
    #|def dump_status_ok(value: object) -> bytes:
    #|    """Encodes a successful response frame around one value.
    #|
    #|    Used by the callback channel: the guest reads a callback's answer with
    #|    the same decoder it uses for a call's answer, so the answer has to be a
    #|    frame and not a bare value.
    #|    """
    #|    out = bytearray()
    #|    out.append(STATUS_OK)
    #|    _dump(value, out)
    #|    return bytes(out)
    #|
    #|
    #|def _dump(value: object, out: bytearray) -> None:
    #|    if value is None:
    #|        out.append(TAG_NULL)
    #|        return
    #|    # `bool` first: in Python `True` is an `int`, and the wire format tells
    #|    # them apart by tag, so the order of these tests is part of the format.
    #|    if value is True:
    #|        out.append(TAG_TRUE)
    #|        return
    #|    if value is False:
    #|        out.append(TAG_FALSE)
    #|        return
    #|    if isinstance(value, Handle):
    #|        out.append(TAG_HANDLE)
    #|        _varint(out, int(value))
    #|        return
    #|    if isinstance(value, int):
    #|        out.append(TAG_INT)
    #|        out += struct.pack("<i", value)
    #|        return
    #|    if isinstance(value, float):
    #|        out.append(TAG_DOUBLE)
    #|        out += struct.pack("<d", value)
    #|        return
    #|    if isinstance(value, str):
    #|        raw = value.encode("utf-8")
    #|        out.append(TAG_STR)
    #|        _varint(out, len(raw))
    #|        out += raw
    #|        return
    #|    if isinstance(value, (bytes, bytearray, memoryview)):
    #|        blob = bytes(value)
    #|        out.append(TAG_BYTES)
    #|        _varint(out, len(blob))
    #|        out += blob
    #|        return
    #|    if isinstance(value, (list, tuple)):
    #|        out.append(TAG_LIST)
    #|        _varint(out, len(value))
    #|        for item in value:
    #|            _dump(item, out)
    #|        return
    #|    if isinstance(value, dict):
    #|        out.append(TAG_MAP)
    #|        _varint(out, len(value))
    #|        for key, item in value.items():
    #|            _dump(key, out)
    #|            _dump(item, out)
    #|        return
    #|    # A generated handle class carries its id and nothing else; duck typing
    #|    # keeps this module free of a circular import of the runtime.
    #|    handle = getattr(value, "_handle", None)
    #|    if isinstance(handle, int):
    #|        out.append(TAG_HANDLE)
    #|        _varint(out, handle)
    #|        return
    #|    raise TypeError(
    #|        f"cannot encode {type(value).__name__} across the MoonBit boundary"
    #|    )
    #|
    #|
    #|class _Reader:
    #|    __slots__ = ("_data", "_pos")
    #|
    #|    def __init__(self, data: bytes) -> None:
    #|        self._data = data
    #|        self._pos = 0
    #|
    #|    def byte(self) -> int:
    #|        if self._pos >= len(self._data):
    #|            raise DecodeError("truncated payload")
    #|        value = self._data[self._pos]
    #|        self._pos += 1
    #|        return value
    #|
    #|    def varint(self) -> int:
    #|        result = 0
    #|        shift = 0
    #|        while True:
    #|            byte = self.byte()
    #|            result |= (byte & 0x7F) << shift
    #|            if not byte & 0x80:
    #|                return result
    #|            shift += 7
    #|            if shift > 28:
    #|                raise DecodeError("varint too long")
    #|
    #|    def take(self, count: int) -> bytes:
    #|        if count < 0 or self._pos + count > len(self._data):
    #|            raise DecodeError("truncated payload")
    #|        chunk = self._data[self._pos : self._pos + count]
    #|        self._pos += count
    #|        return chunk
    #|
    #|    def value(self) -> Any:
    #|        tag = self.byte()
    #|        if tag == TAG_NULL:
    #|            return None
    #|        if tag == TAG_TRUE:
    #|            return True
    #|        if tag == TAG_FALSE:
    #|            return False
    #|        if tag == TAG_INT:
    #|            return struct.unpack("<i", self.take(4))[0]
    #|        if tag == TAG_DOUBLE:
    #|            return struct.unpack("<d", self.take(8))[0]
    #|        if tag == TAG_STR:
    #|            return self.take(self.varint()).decode("utf-8")
    #|        if tag == TAG_BYTES:
    #|            return self.take(self.varint())
    #|        if tag == TAG_LIST:
    #|            return [self.value() for _ in range(self.varint())]
    #|        if tag == TAG_MAP:
    #|            return {self.value(): self.value() for _ in range(self.varint())}
    #|        if tag == TAG_HANDLE:
    #|            return Handle(self.varint())
    #|        raise DecodeError(f"unknown tag {tag}")
    #|
    #|
    #|def load(data: bytes) -> Any:
    #|    """Decodes exactly one value; trailing bytes are an error."""
    #|    reader = _Reader(data)
    #|    value = reader.value()
    #|    if reader._pos != len(data):
    #|        raise DecodeError("trailing bytes after value")
    #|    return value
    #|
    #|
    #|def load_status(data: bytes) -> tuple[int, Any]:
    #|    """Decodes a response frame into its status and payload."""
    #|    if not data:
    #|        raise DecodeError("empty response")
    #|    reader = _Reader(data)
    #|    status = reader.byte()
    #|    value = reader.value()
    #|    return status, value
    #|
    #|
    #|def dump_batch(items: Sequence[bytes]) -> bytes:
    #|    """Packs N already-encoded frames into one crossing.
    #|
    #|    The container is `<u32 count> (<u32 len> <frame>)*`, byte for byte
    #|    the one `src/abi/codec.mbt` pins with golden vectors. The host uses
    #|    it for the request and the guest uses it for the response.
    #|    """
    #|    out = bytearray(struct.pack("<I", len(items)))
    #|    for item in items:
    #|        out += struct.pack("<I", len(item))
    #|        out += item
    #|    return bytes(out)
    #|
    #|
    #|def load_batch(data: bytes) -> list[bytes]:
    #|    """Splits a batch container back into its frames."""
    #|    if len(data) < 4:
    #|        raise DecodeError("truncated batch")
    #|    count = int(struct.unpack_from("<I", data, 0)[0])
    #|    frames: list[bytes] = []
    #|    pos = 4
    #|    for _ in range(count):
    #|        if pos + 4 > len(data):
    #|            raise DecodeError("truncated batch length")
    #|        size = int(struct.unpack_from("<I", data, pos)[0])
    #|        pos += 4
    #|        if pos + size > len(data):
    #|            raise DecodeError("truncated batch frame")
    #|        frames.append(data[pos : pos + size])
    #|        pos += size
    #|    if pos != len(data):
    #|        raise DecodeError("trailing bytes after batch")
    #|    return frames
    #|
  text
}

///|
/// Handle lifetime and call dispatch. This is the module a user's code touches
/// when something goes wrong, so its failure modes are explicit.
pub fn render_runtime() -> String {
  let text =
    #|"""Runtime support for generated MoonBridge bindings.
    #|
    #|Generated by MoonBridge. Do not edit by hand.
    #|
    #|Two jobs live here: turning a call into a request frame and an exception
    #|back into a Python value, and making sure the objects a caller holds are
    #|released in the guest without leaking and without being released twice.
    #|"""
    #|
    #|from __future__ import annotations
    #|
    #|import weakref
    #|from typing import Any, Callable, Final, Sequence, TypeVar
    #|
    #|from . import _codec
    #|
    #|__all__ = [
    #|    "MoonError",
    #|    "MoonObject",
    #|    "MoonPanic",
    #|    "MoonStateError",
    #|    "Runtime",
    #|    "default",
    #|    "set_default",
    #|]
    #|
    #|#: How many deferred releases are batched into one guest call. Small enough
    #|#: that a burst of garbage is not held for long, large enough that the
    #|#: cross-boundary cost is amortised to nothing.
    #|RELEASE_BATCH: Final = 64
    #|
    #|
    #|class MoonError(Exception):
    #|    """Base class of every error raised across the MoonBridge boundary.
    #|
    #|    MoonBit `suberror` declarations are generated as subclasses of this, so
    #|    `except MoonError` catches anything that originated in MoonBit. It
    #|    derives from `Exception`, not `BaseException`: a bridge failure is an
    #|    ordinary failure and code that catches `Exception` should see it.
    #|    """
    #|
    #|    message: str
    #|
    #|    def __init__(self, message: str) -> None:
    #|        super().__init__(message)
    #|        self.message = message
    #|
    #|
    #|class MoonPanic(MoonError):
    #|    """The guest hit a state it does not handle."""
    #|
    #|
    #|class MoonStateError(MoonError):
    #|    """A handle was used after it was released, or no runtime is configured."""
    #|
    #|
    #|#: Qualified MoonBit error name -> the generated class that stands for it.
    #|#:
    #|#: The guest has no idea what a Python class is, so a failure carries the
    #|#: MoonBit name of the error and this table is what turns it back into the
    #|#: class a caller wrote `except` for.
    #|_FAILURES: dict[str, type[MoonError]] = {}
    #|
    #|
    #|def register_failure(name: str, cls: type[MoonError]) -> None:
    #|    """Publishes the class a failure named `name` has to be raised as.
    #|
    #|    Called once per `suberror` by the generated module that declares it, at
    #|    import time. A name nobody registered still fails, as a plain
    #|    `MoonError`: an error from a package whose module was never imported is
    #|    still an error, just one there is no specific class for.
    #|    """
    #|    _FAILURES[name] = cls
    #|
    #|
    #|def failure(value: object) -> MoonError:
    #|    """Builds the exception a failure frame describes.
    #|
    #|    Two shapes arrive here. A guest that knows the error's type sends a map
    #|    with `type` and `message`; one that does not — an older guest, or a
    #|    `raise` with no named error — sends the message alone.
    #|    """
    #|    if isinstance(value, dict):
    #|        kind = value.get("type")
    #|        message = value.get("message")
    #|        if isinstance(kind, str) and isinstance(message, str):
    #|            cls = _FAILURES.get(kind)
    #|            if cls is not None:
    #|                return cls(message)
    #|            return MoonError(message)
    #|    return MoonError(str(value))
    #|
    #|
    #|def _release_partial(values: list[Any]) -> None:
    #|    """Closes handles a failed batch already produced.
    #|
    #|    A batch is fail fast: sub-calls before the failing one already ran in
    #|    the guest, so any handle among their results needs its owner closed
    #|    before the exception leaves. Without this, a typed error in the
    #|    middle of a batch of object-returning calls would leak.
    #|    """
    #|    for value in values:
    #|        close = getattr(value, "close", None)
    #|        if callable(close):
    #|            close()
    #|
    #|
    #|class MoonObject:
    #|    """Base class of every generated handle type.
    #|
    #|    A MoonBit value is never copied into Python. The Python object holds an
    #|    opaque integer handle while the value keeps living in the MoonBit heap,
    #|    which is what keeps identity, mutability and recursive structures intact.
    #|
    #|    Lifetime: `close()` releases immediately, `with ...:` releases on exit,
    #|    and simply dropping the object releases it in batches when Python
    #|    collects it. `__del__` is deliberately not used — it can run during
    #|    interpreter shutdown, when the runtime it needs may already be gone —
    #|    so collection is hooked through `weakref.finalize` instead, which is
    #|    safe at that point and cannot resurrect the object.
    #|    """
    #|
    #|    __slots__ = ("_handle", "_runtime", "_finalizer", "_type_id", "__weakref__")
    #|
    #|    _handle: int
    #|    _runtime: Runtime | None
    #|    # `weakref.finalize` is generic over the watched type *and* the
    #|    # callback's arguments, so naming its type here only couples this file
    #|    # to one typeshed version.
    #|    _finalizer: Any
    #|
    #|    #: Which of the guest's handle tables holds this object.
    #|    #:
    #|    #: The guest keeps one table per concrete type — it has no runtime type
    #|    #: information, so one table could not hold two types — and an id is only
    #|    #: unique inside its own table. A generated subclass sets this to the tag
    #|    #: of its table; 0 means "no table", which is what a class the guest
    #|    #: cannot hold keeps.
    #|    moon_type_id: int = 0
    #|
    #|    def __init__(self, handle: int = 0, runtime: Runtime | None = None) -> None:
    #|        self._handle = handle
    #|        self._runtime = runtime
    #|        self._type_id = type(self).moon_type_id
    #|        self._finalizer = None
    #|        if runtime is not None and handle != 0:
    #|            self._finalizer = weakref.finalize(
    #|                self, runtime.deferred_release, handle, self._type_id
    #|            )
    #|
    #|    @property
    #|    def handle_id(self) -> int:
    #|        """The id this object stands for. `0` once released.
    #|
    #|        Named `handle_id` rather than `handle` because MoonBit packages
    #|        routinely have a field called `handle`, and a generated property
    #|        cannot shadow the base class it inherits from.
    #|        """
    #|        return self._handle
    #|
    #|    def close(self) -> None:
    #|        """Releases the guest object now.
    #|
    #|        Idempotent: a second call does nothing, which matters because
    #|        `close()` and the finalizer can race.
    #|        """
    #|        handle = self._handle
    #|        if handle == 0:
    #|            return
    #|        if self._finalizer is not None:
    #|            self._finalizer.detach()
    #|            self._finalizer = None
    #|        self._handle = 0
    #|        runtime = self._runtime
    #|        if runtime is not None:
    #|            runtime.release_now(handle, self._type_id)
    #|
    #|    def __enter__(self) -> MoonObject:
    #|        return self
    #|
    #|    def __exit__(self, *exc: object) -> None:
    #|        self.close()
    #|
    #|    def __repr__(self) -> str:
    #|        return f"<{type(self).__name__} handle={self._handle}>"
    #|
    #|
    #|T = TypeVar("T", bound=MoonObject)
    #|
    #|
    #|class Runtime:
    #|    """Turns a call into a frame, and a response into a value or an error.
    #|
    #|    The transport is one callable, which is what lets the same generated
    #|    bindings run on wasmtime, on a shared library, or on a test double that
    #|    never leaves the process.
    #|    """
    #|
    #|    def __init__(
    #|        self,
    #|        call: Callable[[str, bytes], bytes],
    #|        *,
    #|        call_batch: Callable[[Sequence[tuple[str, bytes]]], list[bytes]] | None = None,
    #|        release_batch: int = RELEASE_BATCH,
    #|    ) -> None:
    #|        self._call = call
    #|        # Optional so a host without `mb_call_batch` (an older guest, or a
    #|        # test double) still supports the batch API by falling back to N
    #|        # single calls instead of failing at import time.
    #|        self._call_batch = call_batch
    #|        self._pending: list[list[int]] = []
    #|        self._release_batch = release_batch
    #|        self._closed = False
    #|        #: Logical calls made, for a caller that wants to see the workload.
    #|        self.calls = 0
    #|        #: Actual host crossings. A batch of N calls adds N to `calls` but
    #|        #: only 1 here; the gap between the two is the whole point.
    #|        self.crossings = 0
    #|        #: Python callables the guest can call back into, by id.
    #|        #:
    #|        #: A MoonBit function value cannot travel: the guest holds an `Int32`
    #|        #: and asks the host to run it. The table is keyed by the id in that
    #|        #: integer and lives as long as the runtime, because a callback may
    #|        #: be stored by the guest and called after the call that passed it.
    #|        self._callbacks: dict[int, Callable[..., Any]] = {}
    #|        self._callback_id: dict[int, int] = {}
    #|        #: Handles released, so a leak test can compare against what it made.
    #|        self.releases = 0
    #|        #: Ids the guest did not recognise. A batch reports how many it
    #|        #: released; anything it could not route — an id from a class that
    #|        #: never got a tag — is a leak, and it is counted rather than
    #|        #: swallowed because a release that silently does nothing is the one
    #|        #: failure a leak test must never see.
    #|        self.dropped = 0
    #|
    #|    def request(self, symbol: str, args: list[object]) -> Any:
    #|        """Sends one call and returns its decoded payload."""
    #|        self.calls += 1
    #|        self.crossings += 1
    #|        response = self._call(symbol, _codec.dump_args(args))
    #|        status, value = _codec.load_status(response)
    #|        if status == _codec.STATUS_OK:
    #|            return value
    #|        if status == _codec.STATUS_FAILED:
    #|            raise failure(value)
    #|        raise MoonPanic(str(value))
    #|
    #|    def request_many(
    #|        self,
    #|        symbol: str,
    #|        args_list: Sequence[Sequence[object]],
    #|        wrap: Callable[[Any], Any] | None = None,
    #|    ) -> list[Any]:
    #|        """Sends N calls to one symbol in a single boundary crossing.
    #|
    #|        `wrap` turns a raw handle into its generated `MoonObject` subclass,
    #|        so a batched call observes exactly the ownership rules a single
    #|        call does. A transport without a batch export degrades to N single
    #|        calls rather than failing: the API stays portable across hosts.
    #|
    #|        Every sub-call runs in the guest even if an earlier one failed,
    #|        so all successful frames are decoded and wrapped before the
    #|        first error is raised. `_release_partial` then closes every
    #|        handle the batch produced, including ones *after* the failure —
    #|        otherwise fail fast would leak exactly those.
    #|        """
    #|        if not args_list:
    #|            return []
    #|        self.calls += len(args_list)
    #|        if self._call_batch is None:
    #|            self.crossings += len(args_list)
    #|            responses = [
    #|                self._call(symbol, _codec.dump_args(list(args)))
    #|                for args in args_list
    #|            ]
    #|        else:
    #|            self.crossings += 1
    #|            responses = self._call_batch(
    #|                [
    #|                    (symbol, _codec.dump_args(list(args)))
    #|                    for args in args_list
    #|                ]
    #|            )
    #|        values: list[Any] = []
    #|        error: MoonError | None = None
    #|        for response in responses:
    #|            status, value = _codec.load_status(response)
    #|            if status == _codec.STATUS_OK:
    #|                values.append(value if wrap is None else wrap(value))
    #|            elif error is None:
    #|                if status == _codec.STATUS_FAILED:
    #|                    error = failure(value)
    #|                else:
    #|                    error = MoonPanic(str(value))
