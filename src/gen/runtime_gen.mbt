//! The Python support modules every generated binding imports.
//!
//! Stubs are typed against these files, so they are part of the generated
//! contract, not an implementation detail of the loader. Keeping them as
//! templates (rather than checked-in `.py` files) means the wheel, the stubs
//! and the runtime cannot drift apart: one run writes all of them.
//!
//! Everything here is type-checked by `mypy --strict` in CI together with the
//! stubs. That is why the code annotates rather than guesses: the runtime is
//! the one place in the generated package where a lie would only show up as a
//! confusing failure at a user's call site.

///|
/// File name of the runtime module inside the generated package.
pub fn runtime_filename() -> String {
  "_runtime.py"
}

///|
/// File name of the codec module inside the generated package.
pub fn codec_filename() -> String {
  "_codec.py"
}

///|
/// File name of the wasmtime host inside the generated package.
pub fn host_filename() -> String {
  "_wasmtime.py"
}

///|
/// The binary codec. Mirrors `src/abi/codec.mbt` tag for tag; the golden
/// vectors in that package's tests are the same bytes this module produces.
pub fn render_codec() -> String {
  let text =
    #|"""Binary codec for the MoonBridge wire format.
    #|
    #|Generated by MoonBridge. Do not edit by hand.
    #|
    #|The format is one tag byte, fixed-width primitives, varint lengths, little
    #|endian, nothing aligned or padded. `src/abi/codec.mbt` is the other half of
    #|this file: the golden vectors in its tests are the bytes produced here.
    #|"""
    #|
    #|from __future__ import annotations
    #|
    #|import struct
    #|from typing import Any, Final, Sequence
    #|
    #|TAG_NULL: Final = 0
    #|TAG_TRUE: Final = 1
    #|TAG_FALSE: Final = 2
    #|TAG_INT: Final = 3
    #|TAG_DOUBLE: Final = 4
    #|TAG_STR: Final = 5
    #|TAG_BYTES: Final = 6
    #|TAG_LIST: Final = 7
    #|TAG_MAP: Final = 8
    #|TAG_HANDLE: Final = 9
    #|
    #|STATUS_OK: Final = 0
    #|STATUS_FAILED: Final = 1
    #|STATUS_PANIC: Final = 2
    #|
    #|
    #|class Handle(int):
    #|    """The id of a value that stayed in the MoonBit heap.
    #|
    #|    A `Handle` is an `int` so it costs nothing to carry around, but it is a
    #|    distinct type so the encoder can tell it apart from a number: `Json` and
    #|    `3` must not travel under the same tag.
    #|    """
    #|
    #|    __slots__ = ()
    #|
    #|    def __repr__(self) -> str:
    #|        return f"Handle({int(self)})"
    #|
    #|
    #|class DecodeError(ValueError):
    #|    """A payload that does not match the wire format."""
    #|
    #|
    #|def _varint(out: bytearray, value: int) -> None:
    #|    if value < 0:
    #|        raise ValueError("negative length")
    #|    while value >= 0x80:
    #|        out.append((value & 0x7F) | 0x80)
    #|        value >>= 7
    #|    out.append(value)
    #|
    #|
    #|def dump(value: object) -> bytes:
    #|    """Encodes one value."""
    #|    out = bytearray()
    #|    _dump(value, out)
    #|    return bytes(out)
    #|
    #|
    #|def dump_args(args: Sequence[object]) -> bytes:
    #|    """Encodes a call's argument list as one list value."""
    #|    out = bytearray()
    #|    out.append(TAG_LIST)
    #|    _varint(out, len(args))
    #|    for item in args:
    #|        _dump(item, out)
    #|    return bytes(out)
    #|
    #|
    #|def _dump(value: object, out: bytearray) -> None:
    #|    if value is None:
    #|        out.append(TAG_NULL)
    #|        return
    #|    # `bool` first: in Python `True` is an `int`, and the wire format tells
    #|    # them apart by tag, so the order of these tests is part of the format.
    #|    if value is True:
    #|        out.append(TAG_TRUE)
    #|        return
    #|    if value is False:
    #|        out.append(TAG_FALSE)
    #|        return
    #|    if isinstance(value, Handle):
    #|        out.append(TAG_HANDLE)
    #|        _varint(out, int(value))
    #|        return
    #|    if isinstance(value, int):
    #|        out.append(TAG_INT)
    #|        out += struct.pack("<i", value)
    #|        return
    #|    if isinstance(value, float):
    #|        out.append(TAG_DOUBLE)
    #|        out += struct.pack("<d", value)
    #|        return
    #|    if isinstance(value, str):
    #|        raw = value.encode("utf-8")
    #|        out.append(TAG_STR)
    #|        _varint(out, len(raw))
    #|        out += raw
    #|        return
    #|    if isinstance(value, (bytes, bytearray, memoryview)):
    #|        blob = bytes(value)
    #|        out.append(TAG_BYTES)
    #|        _varint(out, len(blob))
    #|        out += blob
    #|        return
    #|    if isinstance(value, (list, tuple)):
    #|        out.append(TAG_LIST)
    #|        _varint(out, len(value))
    #|        for item in value:
    #|            _dump(item, out)
    #|        return
    #|    if isinstance(value, dict):
    #|        out.append(TAG_MAP)
    #|        _varint(out, len(value))
    #|        for key, item in value.items():
    #|            _dump(key, out)
    #|            _dump(item, out)
    #|        return
    #|    # A generated handle class carries its id and nothing else; duck typing
    #|    # keeps this module free of a circular import of the runtime.
    #|    handle = getattr(value, "_handle", None)
    #|    if isinstance(handle, int):
    #|        out.append(TAG_HANDLE)
    #|        _varint(out, handle)
    #|        return
    #|    raise TypeError(
    #|        f"cannot encode {type(value).__name__} across the MoonBit boundary"
    #|    )
    #|
    #|
    #|class _Reader:
    #|    __slots__ = ("_data", "_pos")
    #|
    #|    def __init__(self, data: bytes) -> None:
    #|        self._data = data
    #|        self._pos = 0
    #|
    #|    def byte(self) -> int:
    #|        if self._pos >= len(self._data):
    #|            raise DecodeError("truncated payload")
    #|        value = self._data[self._pos]
    #|        self._pos += 1
    #|        return value
    #|
    #|    def varint(self) -> int:
    #|        result = 0
    #|        shift = 0
    #|        while True:
    #|            byte = self.byte()
    #|            result |= (byte & 0x7F) << shift
    #|            if not byte & 0x80:
    #|                return result
    #|            shift += 7
    #|            if shift > 28:
    #|                raise DecodeError("varint too long")
    #|
    #|    def take(self, count: int) -> bytes:
    #|        if count < 0 or self._pos + count > len(self._data):
    #|            raise DecodeError("truncated payload")
    #|        chunk = self._data[self._pos : self._pos + count]
    #|        self._pos += count
    #|        return chunk
    #|
    #|    def value(self) -> Any:
    #|        tag = self.byte()
    #|        if tag == TAG_NULL:
    #|            return None
    #|        if tag == TAG_TRUE:
    #|            return True
    #|        if tag == TAG_FALSE:
    #|            return False
    #|        if tag == TAG_INT:
    #|            return struct.unpack("<i", self.take(4))[0]
    #|        if tag == TAG_DOUBLE:
    #|            return struct.unpack("<d", self.take(8))[0]
    #|        if tag == TAG_STR:
    #|            return self.take(self.varint()).decode("utf-8")
    #|        if tag == TAG_BYTES:
    #|            return self.take(self.varint())
    #|        if tag == TAG_LIST:
    #|            return [self.value() for _ in range(self.varint())]
    #|        if tag == TAG_MAP:
    #|            return {self.value(): self.value() for _ in range(self.varint())}
    #|        if tag == TAG_HANDLE:
    #|            return Handle(self.varint())
    #|        raise DecodeError(f"unknown tag {tag}")
    #|
    #|
    #|def load(data: bytes) -> Any:
    #|    """Decodes exactly one value; trailing bytes are an error."""
    #|    reader = _Reader(data)
    #|    value = reader.value()
    #|    if reader._pos != len(data):
    #|        raise DecodeError("trailing bytes after value")
    #|    return value
    #|
    #|
    #|def load_status(data: bytes) -> tuple[int, Any]:
    #|    """Decodes a response frame into its status and payload."""
    #|    if not data:
    #|        raise DecodeError("empty response")
    #|    reader = _Reader(data)
    #|    status = reader.byte()
    #|    value = reader.value()
    #|    return status, value
    #|
  text
}

///|
/// Handle lifetime and call dispatch. This is the module a user's code touches
/// when something goes wrong, so its failure modes are explicit.
pub fn render_runtime() -> String {
  let text =
    #|"""Runtime support for generated MoonBridge bindings.
    #|
    #|Generated by MoonBridge. Do not edit by hand.
    #|
    #|Two jobs live here: turning a call into a request frame and an exception
    #|back into a Python value, and making sure the objects a caller holds are
    #|released in the guest without leaking and without being released twice.
    #|"""
    #|
    #|from __future__ import annotations
    #|
    #|import weakref
    #|from typing import Any, Callable, Final, TypeVar
    #|
    #|from . import _codec
    #|
    #|__all__ = [
    #|    "MoonError",
    #|    "MoonObject",
    #|    "MoonPanic",
    #|    "MoonStateError",
    #|    "Runtime",
    #|    "default",
    #|    "set_default",
    #|]
    #|
    #|#: How many deferred releases are batched into one guest call. Small enough
    #|#: that a burst of garbage is not held for long, large enough that the
    #|#: cross-boundary cost is amortised to nothing.
    #|RELEASE_BATCH: Final = 64
    #|
    #|
    #|class MoonError(Exception):
    #|    """Base class of every error raised across the MoonBridge boundary.
    #|
    #|    MoonBit `suberror` declarations are generated as subclasses of this, so
    #|    `except MoonError` catches anything that originated in MoonBit. It
    #|    derives from `Exception`, not `BaseException`: a bridge failure is an
    #|    ordinary failure and code that catches `Exception` should see it.
    #|    """
    #|
    #|    message: str
    #|
    #|    def __init__(self, message: str) -> None:
    #|        super().__init__(message)
    #|        self.message = message
    #|
    #|
    #|class MoonPanic(MoonError):
    #|    """The guest hit a state it does not handle."""
    #|
    #|
    #|class MoonStateError(MoonError):
    #|    """A handle was used after it was released, or no runtime is configured."""
    #|
    #|
    #|class MoonObject:
    #|    """Base class of every generated handle type.
    #|
    #|    A MoonBit value is never copied into Python. The Python object holds an
    #|    opaque integer handle while the value keeps living in the MoonBit heap,
    #|    which is what keeps identity, mutability and recursive structures intact.
    #|
    #|    Lifetime: `close()` releases immediately, `with ...:` releases on exit,
    #|    and simply dropping the object releases it in batches when Python
    #|    collects it. `__del__` is deliberately not used — it can run during
    #|    interpreter shutdown, when the runtime it needs may already be gone —
    #|    so collection is hooked through `weakref.finalize` instead, which is
    #|    safe at that point and cannot resurrect the object.
    #|    """
    #|
    #|    __slots__ = ("_handle", "_runtime", "_finalizer", "__weakref__")
    #|
    #|    _handle: int
    #|    _runtime: Runtime | None
    #|    # `weakref.finalize` is generic over the watched type *and* the
    #|    # callback's arguments, so naming its type here only couples this file
    #|    # to one typeshed version.
    #|    _finalizer: Any
    #|
    #|    def __init__(self, handle: int = 0, runtime: Runtime | None = None) -> None:
    #|        self._handle = handle
    #|        self._runtime = runtime
    #|        self._finalizer = None
    #|        if runtime is not None and handle != 0:
    #|            self._finalizer = weakref.finalize(
    #|                self, runtime.deferred_release, handle
    #|            )
    #|
    #|    @property
    #|    def handle_id(self) -> int:
    #|        """The id this object stands for. `0` once released.
    #|
    #|        Named `handle_id` rather than `handle` because MoonBit packages
    #|        routinely have a field called `handle`, and a generated property
    #|        cannot shadow the base class it inherits from.
    #|        """
    #|        return self._handle
    #|
    #|    def close(self) -> None:
    #|        """Releases the guest object now.
    #|
    #|        Idempotent: a second call does nothing, which matters because
    #|        `close()` and the finalizer can race.
    #|        """
    #|        handle = self._handle
    #|        if handle == 0:
    #|            return
    #|        if self._finalizer is not None:
    #|            self._finalizer.detach()
    #|            self._finalizer = None
    #|        self._handle = 0
    #|        runtime = self._runtime
    #|        if runtime is not None:
    #|            runtime.release_now(handle)
    #|
    #|    def __enter__(self) -> MoonObject:
    #|        return self
    #|
    #|    def __exit__(self, *exc: object) -> None:
    #|        self.close()
    #|
    #|    def __repr__(self) -> str:
    #|        return f"<{type(self).__name__} handle={self._handle}>"
    #|
    #|
    #|T = TypeVar("T", bound=MoonObject)
    #|
    #|
    #|class Runtime:
    #|    """Turns a call into a frame, and a response into a value or an error.
    #|
    #|    The transport is one callable, which is what lets the same generated
    #|    bindings run on wasmtime, on a shared library, or on a test double that
    #|    never leaves the process.
    #|    """
    #|
    #|    def __init__(
    #|        self,
    #|        call: Callable[[str, bytes], bytes],
    #|        *,
    #|        release_batch: int = RELEASE_BATCH,
    #|    ) -> None:
    #|        self._call = call
    #|        self._pending: list[int] = []
    #|        self._release_batch = release_batch
    #|        self._closed = False
    #|        #: Frames sent, for a caller that wants to see the boundary's cost.
    #|        self.calls = 0
    #|        #: Handles released, so a leak test can compare against what it made.
    #|        self.releases = 0
    #|
    #|    def request(self, symbol: str, args: list[object]) -> Any:
    #|        """Sends one call and returns its decoded payload."""
    #|        self.calls += 1
    #|        response = self._call(symbol, _codec.dump_args(args))
    #|        status, value = _codec.load_status(response)
    #|        if status == _codec.STATUS_OK:
    #|            return value
    #|        if status == _codec.STATUS_FAILED:
    #|            raise MoonError(str(value))
    #|        raise MoonPanic(str(value))
    #|
    #|    def deferred_release(self, handle: int) -> None:
    #|        """Queues a handle whose Python wrapper was collected."""
    #|        if self._closed:
    #|            return
    #|        # A release batch carries ids, not objects: `int` tells the codec to
    #|        # write a number instead of a handle to be resolved again.
    #|        self._pending.append(int(handle))
    #|        if len(self._pending) >= self._release_batch:
    #|            self.flush()
    #|
    #|    def release_now(self, handle: int) -> None:
    #|        """Releases one handle immediately, bypassing the batch."""
    #|        if self._closed:
    #|            return
    #|        self._pending.append(int(handle))
    #|        self.flush()
    #|
    #|    def flush(self) -> int:
    #|        """Sends every queued release as a single call."""
    #|        if self._closed or not self._pending:
    #|            return 0
    #|        batch = self._pending
    #|        self._pending = []
    #|        released = self.request("abi.release", [batch])
    #|        count = released if isinstance(released, int) else 0
    #|        self.releases += count
    #|        return count
    #|
    #|    def live_handles(self) -> int:
    #|        """Objects the guest still holds. The number a leak test watches."""
    #|        live = self.request("abi.live", [])
    #|        return live if isinstance(live, int) else -1
    #|
    #|    def close(self) -> None:
    #|        """Releases everything still queued, then refuses further calls."""
    #|        if self._closed:
    #|            return
    #|        self.flush()
    #|        self._closed = True
    #|
    #|    def __enter__(self) -> Runtime:
    #|        return self
    #|
    #|    def __exit__(self, *exc: object) -> None:
    #|        self.close()
    #|
    #|
    #|def wrap(cls: type[T], handle: int) -> T:
    #|    """Builds the declared class around a handle the guest just returned."""
    #|    return cls(handle, default())
    #|
    #|
    #|_default: Runtime | None = None
    #|
    #|
    #|def set_default(runtime: Runtime) -> None:
    #|    """Installs the runtime generated modules use."""
    #|    global _default
    #|    _default = runtime
    #|
    #|
    #|def default() -> Runtime:
    #|    """The installed runtime, or an error that says how to install one."""
    #|    if _default is None:
    #|        raise MoonStateError(
    #|            "no MoonBridge runtime is installed; call "
    #|            "moonbridge._runtime.set_default(...) first"
    #|        )
    #|    return _default
    #|
  text
}

///|
/// The wasmtime host: the only file in the package that knows wasm exists.
pub fn render_host() -> String {
  let text =
    #|"""A wasmtime host for a MoonBridge guest module.
    #|
    #|Generated by MoonBridge. Do not edit by hand.
    #|
    #|The host never assumes where a MoonBit `Bytes` object keeps its payload.
    #|It measures that once, at load, by finding a fingerprinted buffer in linear
    #|memory. If the toolchain ever moves the data, the error is raised here
    #|instead of silently corrupting a payload.
    #|"""
    #|
    #|from __future__ import annotations
    #|
    #|import struct
    #|from pathlib import Path
    #|from typing import Any
    #|
    #|import wasmtime
    #|
    #|from . import _runtime
    #|
    #|__all__ = ["WasmHost", "open_runtime"]
    #|
    #|#: Sentinel whose position reveals where a buffer object keeps its data.
    #|PROBE_MARKER = b"MOONBRIDGE-PROBE-DATA-OFFSET-0420"
    #|
    #|#: How far either side of the object pointer the probe looks.
    #|PROBE_WINDOW = 256
    #|
    #|
    #|class WasmHost:
    #|    """Drives one instantiated guest module.
    #|
    #|    Not thread safe: a wasm instance has a single mutable memory and the
    #|    guest's buffers are shared state. One host per thread, or a lock.
    #|    """
    #|
    #|    def __init__(self, wasm: str | Path) -> None:
    #|        engine = wasmtime.Engine(wasmtime.Config())
    #|        module = wasmtime.Module.from_file(engine, str(wasm))
    #|        self._store = wasmtime.Store(engine)
    #|        self._instance = wasmtime.Instance(self._store, module, [])
    #|        exports = self._instance.exports(self._store)
    #|        memory = exports["memory"]
    #|        if not isinstance(memory, wasmtime.Memory):
    #|            raise _runtime.MoonError("guest did not export a memory named 'memory'")
    #|        self._memory = memory
    #|        # `wasmtime` types exports as `Extern`; the guest's ABI is fixed, so
    #|        # the four functions are taken as callables and coerced at use.
    #|        self._in_reserve: Any = exports["mb_in_reserve"]
    #|        self._stage: Any = exports["mb_stage"]
    #|        self._call: Any = exports["mb_call"]
    #|        self._live: Any = exports["mb_live_handles"]
    #|        self._probe: Any = exports["mb_probe"]
    #|        self._probe_out: Any = exports["mb_probe_out"]
    #|        # The input buffer is a `Bytes` and the response buffer is a
    #|        # `FixedArray[Byte]`; the two layouts are not promised to match, so
    #|        # each is measured rather than assumed.
    #|        self._in_offset = self._find_data_offset(self._probe, "input")
    #|        self._out_offset = self._find_data_offset(self._probe_out, "response")
    #|        self._in_ptr = 0
    #|        self._in_capacity = 0
    #|        self._out_ptr = 0
    #|        self._out_capacity = 0
    #|
    #|    def _find_data_offset(self, probe: Any, what: str) -> int:
    #|        pointer = int(probe(self._store))
    #|        start = max(0, pointer - 64)
    #|        allowed = bytes(
    #|            self._memory.read(self._store, start, pointer + PROBE_WINDOW)
    #|        )
    #|        index = allowed.find(PROBE_MARKER)
    #|        if index < 0:
    #|            raise _runtime.MoonError(
    #|                f"could not locate the guest's {what} buffer layout; "
    #|                "the MoonBit toolchain probably changed it"
    #|            )
    #|        return start + index - pointer
    #|
    #|    def _ensure_input(self, size: int) -> None:
    #|        if size > self._in_capacity:
    #|            self._in_ptr = int(self._in_reserve(self._store, size))
    #|            self._in_capacity = size
    #|
    #|    def _ensure_output(self, size: int) -> None:
    #|        """Refreshes the response pointer when the guest had to grow it."""
    #|        if size > self._out_capacity:
    #|            self._out_ptr = int(self._stage(self._store))
    #|            # The guest grows the buffer to fit what it is publishing, so the
    #|            # size just seen is a lower bound on what is now reserved. A
    #|            # reallocation is always a growth, so this only asks again when a
    #|            # larger response arrives than any before it.
    #|            self._out_capacity = size
    #|
    #|    def call(self, symbol: str, payload: bytes) -> bytes:
    #|        """Sends one frame and returns the response bytes."""
    #|        name = symbol.encode("utf-8")
    #|        frame = struct.pack("<I", len(name)) + name + payload
    #|        self._ensure_input(len(frame))
    #|        self._memory.write(self._store, frame, self._in_ptr + self._in_offset)
    #|        length = int(self._call(self._store, len(frame)))
    #|        self._ensure_output(length)
    #|        base = self._out_ptr + self._out_offset
    #|        return bytes(self._memory.read(self._store, base, base + length))
    #|
    #|    def live_handles(self) -> int:
    #|        """Objects the guest still holds, without going through the codec."""
    #|        return int(self._live(self._store))
    #|
    #|    def memory_bytes(self) -> int:
    #|        """Linear memory currently mapped, for a leak curve."""
    #|        return self._memory.data_len(self._store)
    #|
    #|    def close(self) -> None:
    #|        """Drops the instance. The guest's handles die with it."""
    #|
    #|    def __enter__(self) -> WasmHost:
    #|        return self
    #|
    #|    def __exit__(self, *exc: object) -> None:
    #|        self.close()
    #|
    #|
    #|def open_runtime(wasm: str | Path) -> tuple[WasmHost, _runtime.Runtime]:
    #|    """Loads a guest and returns it with a runtime pointed at it."""
    #|    host = WasmHost(wasm)
    #|    return host, _runtime.Runtime(host.call)
    #|
  text
}

///|
/// Package marker that makes the generated directory a typed distribution.
pub fn render_init() -> String {
  "\"\"\"Generated Python bindings for MoonBit packages.\n" +
  "\n" +
  "This package is written by MoonBridge. Do not edit by hand.\n" +
  "\"\"\"\n" +
  "\n" +
  "from ._runtime import (\n" +
  "    MoonError,\n" +
  "    MoonObject,\n" +
  "    MoonPanic,\n" +
  "    MoonStateError,\n" +
  "    Runtime,\n" +
  "    default,\n" +
  "    set_default,\n" +
  ")\n" +
  "\n" +
  "__all__ = [\n" +
  "    \"MoonError\",\n" +
