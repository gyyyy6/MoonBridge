  text
}

///|
/// The wasmtime host: the only file in the package that knows wasm exists.
pub fn render_host() -> String {
  let text =
    #|"""A wasmtime host for a MoonBridge guest module.
    #|
    #|Generated by MoonBridge. Do not edit by hand.
    #|
    #|The host never assumes where a MoonBit `Bytes` object keeps its payload.
    #|It measures that once, at load, by finding a fingerprinted buffer in linear
    #|memory. If the toolchain ever moves the data, the error is raised here
    #|instead of silently corrupting a payload.
    #|"""
    #|
    #|from __future__ import annotations
    #|
    #|import struct
    #|from pathlib import Path
    #|from typing import Any, Sequence
    #|
    #|import wasmtime
    #|
    #|from . import _codec
    #|from . import _runtime
    #|
    #|__all__ = ["WasmHost", "open_runtime"]
    #|
    #|#: Sentinel whose position reveals where a buffer object keeps its data.
    #|PROBE_MARKER = b"MOONBRIDGE-PROBE-DATA-OFFSET-0420"
    #|
    #|#: How far either side of the object pointer the probe looks.
    #|PROBE_WINDOW = 256
    #|
    #|
    #|class WasmHost:
    #|    """Drives one instantiated guest module.
    #|
    #|    Not thread safe: a wasm instance has a single mutable memory and the
    #|    guest's buffers are shared state. One host per thread, or a lock.
    #|    """
    #|
    #|    def __init__(self, wasm: str | Path) -> None:
    #|        engine = wasmtime.Engine(wasmtime.Config())
    #|        module = wasmtime.Module.from_file(engine, str(wasm))
    #|        self._store = wasmtime.Store(engine)
    #|        self._runtime: _runtime.Runtime | None = None
    #|        #: An exception raised by a callback, held until the outer call
    #|        #: returns. It cannot be raised where it happens: the guest is on the
    #|        #: stack, and unwinding through it would leave its buffers half
    #|        #: written.
    #|        self._callback_error: BaseException | None = None
    #|        # The guest imports one host function, for the callback channel. It is
    #|        # linked even when the module does not import it: a linker tolerates
    #|        # an unused definition and rejects a missing one.
    #|        linker = wasmtime.Linker(engine)
    #|        callback_type = wasmtime.FuncType(
    #|            [wasmtime.ValType.i32(), wasmtime.ValType.i32()],
    #|            [wasmtime.ValType.i32()],
    #|        )
    #|        linker.define_func(
    #|            "env", "mb_cb_invoke", callback_type, self._invoke_callback
    #|        )
    #|        self._instance = linker.instantiate(self._store, module)
    #|        exports = self._instance.exports(self._store)
    #|        memory = exports["memory"]
    #|        if not isinstance(memory, wasmtime.Memory):
    #|            raise _runtime.MoonError("guest did not export a memory named 'memory'")
    #|        self._memory = memory
    #|        # `wasmtime` types exports as `Extern`; the guest's ABI is fixed, so
    #|        # the four functions are taken as callables and coerced at use.
    #|        self._in_reserve: Any = exports["mb_in_reserve"]
    #|        self._stage: Any = exports["mb_stage"]
    #|        self._call: Any = exports["mb_call"]
    #|        # A guest built before the batch protocol has no such export.
    #|        # `call_batch` then falls back to N single calls, so an old
    #|        # wheel and a new binding still agree on the API.
    #|        try:
    #|            self._batch: Any = exports["mb_call_batch"]
    #|        except KeyError:
    #|            self._batch = None
    #|        self._live: Any = exports["mb_live_handles"]
    #|        self._probe: Any = exports["mb_probe"]
    #|        self._probe_out: Any = exports["mb_probe_out"]
    #|        # Ask for the guest-owned buffer a callback's answer is written into.
    #|        # A module with no callback in its plan does not export it, and the
    #|        # import is then never called either.
    #|        try:
    #|            self._cb_buffer: Any = exports["mb_cb_buffer"]
    #|        except KeyError:
    #|            self._cb_buffer = None
    #|        # The input buffer is a `Bytes` and the response buffer is a
    #|        # `FixedArray[Byte]`; the two layouts are not promised to match, so
    #|        # each is measured rather than assumed.
    #|        self._in_offset = self._find_data_offset(self._probe, "input")
    #|        self._out_offset = self._find_data_offset(self._probe_out, "response")
    #|        self._in_ptr = 0
    #|        self._in_capacity = 0
    #|        self._out_ptr = 0
    #|        self._out_capacity = 0
    #|
    #|    def attach(self, runtime: _runtime.Runtime) -> None:
    #|        """Points the callback import at the runtime that owns the table."""
    #|        self._runtime = runtime
    #|
    #|    def _find_data_offset(self, probe: Any, what: str) -> int:
    #|        pointer = int(probe(self._store))
    #|        start = max(0, pointer - 64)
    #|        allowed = bytes(
    #|            self._memory.read(self._store, start, pointer + PROBE_WINDOW)
    #|        )
    #|        index = allowed.find(PROBE_MARKER)
    #|        if index < 0:
    #|            raise _runtime.MoonError(
    #|                f"could not locate the guest's {what} buffer layout; "
    #|                "the MoonBit toolchain probably changed it"
    #|            )
    #|        return start + index - pointer
    #|
    #|    def _ensure_input(self, size: int) -> None:
    #|        if size > self._in_capacity:
    #|            self._in_ptr = int(self._in_reserve(self._store, size))
    #|            self._in_capacity = size
    #|
    #|    def _ensure_output(self, size: int) -> None:
    #|        """Refreshes the response pointer when the guest had to grow it."""
    #|        if size > self._out_capacity:
    #|            self._out_ptr = int(self._stage(self._store))
    #|            # The guest grows the buffer to fit what it is publishing, so the
    #|            # size just seen is a lower bound on what is now reserved. A
    #|            # reallocation is always a growth, so this only asks again when a
    #|            # larger response arrives than any before it.
    #|            self._out_capacity = size
    #|
    #|    def call(self, symbol: str, payload: bytes) -> bytes:
    #|        """Sends one frame and returns the response bytes."""
    #|        name = symbol.encode("utf-8")
    #|        frame = struct.pack("<I", len(name)) + name + payload
    #|        self._ensure_input(len(frame))
    #|        self._memory.write(self._store, frame, self._in_ptr + self._in_offset)
    #|        length = int(self._call(self._store, len(frame)))
    #|        # A callback that raised could not unwind through the guest, so it is
    #|        # re-raised here, where the guest is no longer on the stack.
    #|        if self._callback_error is not None:
    #|            error = self._callback_error
    #|            self._callback_error = None
    #|            raise error
    #|        self._ensure_output(length)
    #|        base = self._out_ptr + self._out_offset
    #|        return bytes(self._memory.read(self._store, base, base + length))
    #|
    #|    def call_batch(self, items: Sequence[tuple[str, bytes]]) -> list[bytes]:
    #|        """Sends N frames in one crossing and returns N status frames.
    #|
    #|        One memory write, one wasm call, one memory read. Every sub-frame
    #|        has the layout `call` uses, so the guest runs them through the
    #|        same dispatcher and no second protocol has to stay in sync.
    #|        """
    #|        if self._batch is None:
    #|            return [self.call(symbol, payload) for symbol, payload in items]
    #|        frames: list[bytes] = []
    #|        for symbol, payload in items:
    #|            name = symbol.encode("utf-8")
    #|            frames.append(struct.pack("<I", len(name)) + name + payload)
    #|        request = _codec.dump_batch(frames)
    #|        self._ensure_input(len(request))
    #|        self._memory.write(self._store, request, self._in_ptr + self._in_offset)
    #|        length = int(self._batch(self._store, len(request)))
    #|        # A callback that raised could not unwind through the guest; it is
    #|        # re-raised here, once the whole batch has returned.
    #|        if self._callback_error is not None:
    #|            error = self._callback_error
    #|            self._callback_error = None
    #|            raise error
    #|        self._ensure_output(length)
    #|        base = self._out_ptr + self._out_offset
    #|        data = bytes(self._memory.read(self._store, base, base + length))
    #|        return _codec.load_batch(data)
    #|
    #|    def _invoke_callback(self, cb_id: int, sent: int) -> int:
    #|        """The host half of the callback channel.
    #|
    #|        The guest published the call's arguments into the response buffer
    #|        before calling, so they are read from where a response normally is.
    #|        The answer is written into a buffer the guest owns — the host cannot
    #|        allocate in the guest's heap, so it asks the guest for the memory and
    #|        writes into that.
    #|
    #|        Returns the number of bytes written, or `0` for "no value": the guest
    #|        substitutes a default and the exception is re-raised from `call`.
    #|        """
    #|        if sent <= 0 or self._cb_buffer is None or self._runtime is None:
    #|            return 0
    #|        self._ensure_output(sent)
    #|        base = self._out_ptr + self._out_offset
    #|        frame = bytes(self._memory.read(self._store, base, base + sent))
    #|        try:
    #|            args = _codec.load(frame)
    #|            result = self._runtime.invoke(int(cb_id), args)
    #|            answer = _codec.dump_status_ok(result)
    #|        except BaseException as error:  # noqa: BLE001 - carried, not swallowed
    #|            self._callback_error = error
    #|            return 0
    #|        # `mb_cb_buffer` returns a `Bytes`, whose payload sits at the same
    #|        # offset the input buffer's does: both are the same MoonBit type.
    #|        pointer = int(self._cb_buffer(self._store, len(answer)))
    #|        self._memory.write(self._store, answer, pointer + self._in_offset)
    #|        return len(answer)
    #|
    #|    def live_handles(self) -> int:
    #|        """Objects the guest still holds, without going through the codec."""
    #|        return int(self._live(self._store))
    #|
    #|    def memory_bytes(self) -> int:
    #|        """Linear memory currently mapped, for a leak curve."""
    #|        return self._memory.data_len(self._store)
    #|
    #|    def close(self) -> None:
    #|        """Drops the instance. The guest's handles die with it."""
    #|
    #|    def __enter__(self) -> WasmHost:
    #|        return self
    #|
    #|    def __exit__(self, *exc: object) -> None:
    #|        self.close()
    #|
    #|
    #|def open_runtime(wasm: str | Path) -> tuple[WasmHost, _runtime.Runtime]:
    #|    """Loads a guest and returns it with a runtime pointed at it."""
    #|    host = WasmHost(wasm)
    #|    runtime = _runtime.Runtime(host.call, call_batch=host.call_batch)
    #|    host.attach(runtime)
    #|    return host, runtime
    #|
  text
}

///|
/// Package marker that makes the generated directory a typed distribution.
pub fn render_init() -> String {
  "\"\"\"Generated Python bindings for MoonBit packages.\n" +
  "\n" +
  "This package is written by MoonBridge. Do not edit by hand.\n" +
  "\"\"\"\n" +
  "\n" +
  "from __future__ import annotations\n" +
  "\n" +
  "from pathlib import Path\n" +
  "from typing import Any, Callable, Sequence\n" +
  "\n" +
  "from ._runtime import (\n" +
  "    MoonError,\n" +
  "    MoonObject,\n" +
  "    MoonPanic,\n" +
  "    MoonStateError,\n" +
  "    Runtime,\n" +
  "    default,\n" +
  "    set_default,\n" +
  ")\n" +
  "\n" +
  "__all__ = [\n" +
  "    \"MoonError\",\n" +
  "    \"MoonObject\",\n" +
  "    \"MoonPanic\",\n" +
  "    \"MoonStateError\",\n" +
  "    \"Runtime\",\n" +
  "    \"default\",\n" +
  "    \"install\",\n" +
  "    \"open_guest\",\n" +
  "    \"run_batch\",\n" +
  "    \"set_default\",\n" +
  "]\n" +
  "\n" +
  "\n" +
  "#: Name of the wasm binary inside the installed package.\n" +
  "_GUEST_FILE = \"_guest.wasm\"\n" +
  "\n" +
  "\n" +
  "def open_guest(wasm: str | Path | None = None) -> tuple[object, Runtime]:\n" +
  "    \"\"\"Loads the guest module this package ships and returns its host.\n" +
  "\n" +
  "    The wheel carries the wasm binary next to this file, so a caller who\n" +
  "    installed the package has nothing to configure. `wasm` overrides it for\n" +
  "    a build that wants to test a freshly compiled guest against an installed\n" +
  "    binding.\n" +
  "    \"\"\"\n" +
  "    from . import _wasmtime\n" +
  "\n" +
  "    path = Path(wasm) if wasm is not None else Path(__file__).with_name(_GUEST_FILE)\n" +
  "    host, runtime = _wasmtime.open_runtime(path)\n" +
  "    return host, runtime\n" +
  "\n" +
  "\n" +
  "def install(wasm: str | Path | None = None) -> tuple[object, Runtime]:\n" +
  "    \"\"\"Loads the guest and makes it the one every generated module calls.\n" +
  "\n" +
  "    This is the whole setup a user needs:\n" +
  "\n" +
  "        host, runtime = moonbridge.install()\n" +
  "        from moonbridge import moonbitlang__core__json as json_ffi\n" +
  "    \"\"\"\n" +
  "    host, runtime = open_guest(wasm)\n" +
  "    set_default(runtime)\n" +
  "    return host, runtime\n" +
  "\n" +
  "\n" +
  "def run_batch(\n" +
  "    symbol: str,\n" +
  "    calls: Sequence[Sequence[object]],\n" +
  "    *,\n" +
  "    wrap: Callable[[Any], Any] | None = None,\n" +
  ") -> list[Any]:\n" +
  "    \"\"\"Runs N calls to one MoonBit symbol in a single boundary crossing.\n" +
  "\n" +
  "    This is the low-level form. Generated modules wrap it as ``<fn>_many``\n" +
  "    so a caller gets typed results and automatic handle ownership; use that\n" +
  "    when the function returns a MoonBit object. `wrap` is the adapter those\n" +
  "    companions pass, and `symbol` is the qualified MoonBit name the module\n" +
  "    sends (``<package>::<function>``).\n" +
  "    \"\"\"\n" +
  "    return default().request_many(symbol, calls, wrap)\n"
}
