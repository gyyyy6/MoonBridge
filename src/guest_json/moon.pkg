import {
  "gyyyy6/moonbridge/abi",
  "moonbitlang/core/buffer",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
}

pkgtype(kind: "foreign_library")

// The host reads and writes linear memory directly, so the memory object must
// have a stable name and the heap must not start at zero (address 0 is a
// perfectly valid pointer and would make "no buffer" indistinguishable).

options(
  link: {
    "wasm": { "export-memory-name": "memory", "heap-start-address": 4096 },
  },
)
