//! MoonBit interface types to Python type expressions.
//!
//! The mapper is deliberately explicit about what it can and cannot express.
//! Four outcomes are possible, in decreasing order of quality:
//!
//! 1. **Direct** — the type has an exact Python counterpart (`Int` -> `int`,
//!    `Array[T]` -> `list[T]`).
//! 2. **Transparent** — the type adds no runtime meaning in Python and is
//!    erased (`Borrowed` erases `&T`, `Optional` collapses `T??`).
//! 3. **Handle** — a class generated by MoonBridge stands in for the value.
//!    The value itself never crosses the boundary; an opaque integer handle
//!    does.
//! 4. **Degraded to `Any`** — the type cannot be represented soundly. This is
//!    never silent: every degradation is recorded in `Mapper::degraded` with a
//!    reason, so the generator can report how much of a package it had to give
//!    up on.
//!
//! The mapper is a pure function of (package shape, type expression). It does
//! not touch the filesystem, which makes the whole table testable without
//! generating code.

///|
/// A Python type expression.
pub(all) enum PyType {
  PyInt
  PyFloat
  PyBool
  PyStr
  PyBytes
  /// `Unit` — rendered as `None`.
  PyNone
  /// An unrepresentable type. Always paired with a `Degrade` record.
  PyAny
  /// A bound type variable, rendered by name and backed by a module `TypeVar`.
  PyVar(String)
  PyList(PyType)
  /// Read-only view, rendered as `Sequence[T]`.
  PySeq(PyType)
  PyDict(PyType, PyType)
  PyTuple(Array[PyType])
  PyOptional(PyType)
  /// A generated class standing in for a MoonBit value: name plus type
  /// arguments, rendered as `Name` or `Name[Int]`.
  PyHandle(String, Array[PyType])
} derive(Debug, Eq)

///|
/// Renders a comma-separated list of type expressions.
pub fn render_types(items : Array[PyType]) -> String {
  let sb = StringBuilder()
  let mut first = true
  for t in items {
    if !first {
      sb.write_string(", ")
    }
    sb.write_string(t.render())
    first = false
  }
  sb.to_string()
}

///|
/// Renders a type as Python source text.
pub fn PyType::render(self : PyType) -> String {
  match self {
    PyInt => "int"
    PyFloat => "float"
    PyBool => "bool"
    PyStr => "str"
    PyBytes => "bytes"
    PyNone => "None"
    PyAny => "Any"
    PyVar(name) => name
    PyList(t) => "list[" + t.render() + "]"
    PySeq(t) => "Sequence[" + t.render() + "]"
    PyDict(k, v) => "dict[" + k.render() + ", " + v.render() + "]"
    PyTuple(items) =>
      if items.length() == 0 {
        "tuple[()]"
      } else {
        "tuple[" + render_types(items) + "]"
      }
    PyOptional(t) => "Optional[" + t.render() + "]"
    PyHandle(name, args) =>
      if args.length() == 0 {
        name
      } else {
        name + "[" + render_types(args) + "]"
      }
  }
}

///|
/// Appends the name of every type variable mentioned by `self`.
pub fn PyType::collect_vars(self : PyType, out : Map[String, Bool]) -> Unit {
  match self {
    PyVar(name) => out.set(name, true)
    PyList(inner) | PySeq(inner) | PyOptional(inner) => inner.collect_vars(out)
    PyDict(k, v) => {
      k.collect_vars(out)
      v.collect_vars(out)
    }
    PyTuple(items) => items.each(fn(t) { t.collect_vars(out) })
    PyHandle(_, args) => args.each(fn(t) { t.collect_vars(out) })
    _ => ()
  }
}

///|
/// Replaces a type variable with `Any` when it is declared by the enclosing
/// function but no parameter mentions it.
///
/// `fn[T] make() -> T` cannot be expressed in Python: the caller has no way to
/// choose `T`, and mypy rejects the signature ("a function returning TypeVar
/// should receive at least one argument containing the same TypeVar"). Saying
/// `Any` is the honest translation of "the caller must decide, and cannot".
pub fn PyType::drop_unbound(
  self : PyType,
  declared : Map[String, Bool],
  bound : Map[String, Bool],
) -> PyType {
  match self {
    PyVar(name) =>
      if declared.contains(name) && !bound.contains(name) {
        PyAny
      } else {
        self
      }
    PyList(inner) => PyList(inner.drop_unbound(declared, bound))
    PySeq(inner) => PySeq(inner.drop_unbound(declared, bound))
    PyOptional(inner) => PyOptional(inner.drop_unbound(declared, bound))
    PyDict(k, v) =>
      PyDict(k.drop_unbound(declared, bound), v.drop_unbound(declared, bound))
    PyTuple(items) =>
      PyTuple(items.map(fn(t) { t.drop_unbound(declared, bound) }))
    PyHandle(name, args) =>
      PyHandle(name, args.map(fn(t) { t.drop_unbound(declared, bound) }))
    _ => self
  }
}

///|
/// `true` when the type is the degraded fallback. Used by tests and reports to
/// count how much of an interface lost precision.
pub fn PyType::is_any(self : PyType) -> Bool {
  match self {
    PyAny => true
    _ => false
  }
}

///|
/// Why a type had to be degraded. The variants are exhaustive on purpose: the
/// mapping report groups by reason, so a new reason must be added deliberately
/// rather than folded into a generic "unsupported" bucket.
pub(all) enum Degrade {
  /// `@json.Json` — a type from another package. S2 emits one stub per package
  /// and never imports across packages, so foreign types become `Any`.
  ForeignType(String)
  /// A bare name that this package neither declares nor the builtin table
  /// knows. Usually a re-exported trait or an alias chain.
  UnknownType(String)
  /// A function-typed value. Bridging callbacks needs a Python->MoonBit
  /// trampoline, which S2 does not build.
  HigherOrderFunction
  /// `async (T) -> U`.
  AsyncValue
  /// A generic argument count that does not match the declaration.
  ArityMismatch(String, Int32, Int32)
  /// `Result[T, E]` — the success type is kept, the error type is dropped
  /// because errors surface as `MoonError` exceptions.
  ResultErased
  /// Nesting deeper than `Mapper::depth_limit`.
  TooDeep
  /// `Self` used outside a type that could name itself.
  UnboundSelf
} derive(Debug, Eq)

///|
/// One-line explanation, used in generated comments and in the mapping report.
pub fn Degrade::describe(self : Degrade) -> String {
  match self {
    ForeignType(name) => "foreign type " + name + " -> Any"
    UnknownType(name) => "unknown type " + name + " -> Any"
    HigherOrderFunction => "function value -> Any (callbacks are not bridged)"
    AsyncValue => "async value -> Any"
    ArityMismatch(name, want, got) =>
      "arity mismatch on " +
      name +
      ": want " +
      want.to_string() +
      ", got " +
      got.to_string()
    ResultErased => "Result[T, E] -> T (errors raise MoonError)"
    TooDeep => "type nesting too deep -> Any"
    UnboundSelf => "Self outside a type context -> Any"
  }
}

///|
/// The mapping context. It is cheap to copy, and copies share `locals` and
/// `degraded`, which is what lets `Mapper::for_decl` narrow the bound type
/// variables without losing the error trail.
pub(all) struct Mapper {
  /// Package under generation; recorded on notes.
  pkg : String
  /// Local type name -> arity. `-1` means "arity unknown", used for re-exports.
  locals : Map[String, Int32]
  /// Type variables in scope, e.g. `T` for `fn[T] f(T)`.
  bound : Map[String, Bool]
  /// The class name `Self` resolves to, inside a type or method.
  self_name : String?
  /// Guards against pathological nesting in generated interfaces.
  depth_limit : Int32
  /// Every degradation, in encounter order.
  degraded : Array[Degrade]
} derive(Debug)

///|
pub fn Mapper::new(pkg : String) -> Mapper {
  {
    pkg,
    locals: Map([]),
    bound: Map([]),
    self_name: None,
    depth_limit: 24,
    degraded: [],
  }
}

///|
/// Records a local type. Later declarations win, which mirrors how a later
/// definition in the same interface would shadow an earlier re-export.
pub fn Mapper::register(self : Mapper, name : String, arity : Int32) -> Unit {
  self.locals.set(name, arity)
}

///|
/// Registers every type the package itself defines, including re-exported
/// names (which have unknown arity).
pub fn Mapper::for_package(pkg : @mbti.Package) -> Mapper {
  let m = Mapper::new(pkg.name)
  for decl in pkg.decls {
    match decl {
      @mbti.Struct(s) => m.register(s.name, s.generics.length())
      @mbti.Enum(e) => m.register(e.name, e.generics.length())
      @mbti.Error(e) => m.register(e.name, e.generics.length())
      @mbti.Opaque(o) => m.register(o.name, o.generics.length())
      @mbti.Alias(a) => m.register(a.name, a.generics.length())
      @mbti.Reexport(r) =>
        for entry in r.entries {
          if entry.kind == "type" {
            m.register(entry.as_name.unwrap_or(entry.name), -1)
          }
        }
      @mbti.Decl::Func(_)
      | @mbti.Value(_)
      | @mbti.Const(_)
      | @mbti.Trait(_)
      | @mbti.Impl(_) => ()
    }
  }
  m
}

///|
/// Narrower context for one declaration: same package, different type
/// variables and possibly a different `Self`.
pub fn Mapper::for_decl(
  self : Mapper,
  generics : Array[@mbti.GenericParam],
  self_name : String?,
) -> Mapper {
  let bound : Map[String, Bool] = Map([])
  for g in generics {
    bound.set(g.name, true)
  }
  {
    pkg: self.pkg,
    locals: self.locals,
    bound,
    self_name,
    depth_limit: self.depth_limit,
    degraded: self.degraded,
  }
}

///|
fn Mapper::note(self : Mapper, reason : Degrade) -> Unit {
  self.degraded.push(reason)
}

///|
/// Degraded positions recorded so far.
pub fn Mapper::degraded_count(self : Mapper) -> Int32 {
  self.degraded.length()
}

///|
/// Number of degradations of one kind, by variant name. Reports use this to
/// print one row per reason.
pub fn Mapper::count_reason(self : Mapper, reason : String) -> Int32 {
  let mut n = 0
  for d in self.degraded {
    let tag = match d {
      ForeignType(_) => "foreign"
      UnknownType(_) => "unknown"
      HigherOrderFunction => "higher-order"
      AsyncValue => "async"
      ArityMismatch(_, _, _) => "arity"
      ResultErased => "result"
      TooDeep => "too-deep"
      UnboundSelf => "unbound-self"
    }
    if tag == reason {
      n = n + 1
    }
  }
  n
}

///|
/// Maps a type expression in the current context.
///
/// If the walk was cut off by `depth_limit`, the whole expression degrades to
/// `Any`: a type that was only partly rendered is not the type, and emitting
/// `Optional[Any]` would suggest the outer structure is still trustworthy.
pub fn Mapper::map(self : Mapper, ty : @mbti.TypeExpr) -> PyType {
  let before = self.count_reason("too-deep")
  let mapped = self.map_at(ty, 0)
  if self.count_reason("too-deep") > before {
    return PyAny
  }
  mapped
}

///|
fn Mapper::map_args(
  self : Mapper,
  items : Array[@mbti.TypeExpr],
  depth : Int32,
) -> Array[PyType] {
  let out : Array[PyType] = []
  for item in items {
    out.push(self.map_at(item, depth + 1))
  }
  out
}

///|
fn Mapper::map_at(self : Mapper, ty : @mbti.TypeExpr, depth : Int32) -> PyType {
  if depth > self.depth_limit {
    self.note(TooDeep)
    return PyAny
  }
  match ty {
    @mbti.TypeExpr::Named(q, args) => self.map_named(q, args, depth)
    @mbti.TypeExpr::SelfType(args) =>
      match self.self_name {
        Some(name) => PyHandle(stub_name(name), self.map_args(args, depth))
        None => {
          self.note(UnboundSelf)
          PyAny
        }
      }
    @mbti.TypeExpr::Tuple(items) => PyTuple(self.map_args(items, depth))
    @mbti.TypeExpr::Func(_, _, _) => {
      self.note(HigherOrderFunction)
      PyAny
    }
    @mbti.TypeExpr::Optional(inner) => {
      let t = self.map_at(inner, depth + 1)
      // `T??` is the same value as `T?`: MoonBit's optional chaining collapses
      // at the boundary, so emit one layer instead of `Optional[Optional[T]]`.
      match t {
        PyOptional(_) => t
        _ => PyOptional(t)
      }
    }
    // A borrow is a calling convention, not a distinct value type. Python has
    // no borrow checker, so `&T` and `T` are the same object handle.
    @mbti.TypeExpr::Borrowed(inner) => self.map_at(inner, depth + 1)
    @mbti.TypeExpr::Async(_) => {
      self.note(AsyncValue)
      PyAny
    }
    @mbti.TypeExpr::Unit => PyNone
  }
}

///|
fn Mapper::map_named(
  self : Mapper,
  q : @mbti.QName,
  args : Array[@mbti.TypeExpr],
  depth : Int32,
) -> PyType {
  match q.pkg {
    Some(pkg) =>
      if pkg == "@builtin" {
        match self.map_builtin(q.name, args, depth) {
          Some(t) => t
          None => self.unknown(q.name)
        }
      } else {
        self.note(ForeignType(q.to_string()))
        PyAny
      }
    None => {
      if self.bound.contains(q.name) {
        // A type variable never takes arguments; if it does, the interface is
        // outside what this mapper understands, so say so rather than emit
        // `T[int]`, which Python would reject at type-check time.
        if args.length() > 0 {
          self.note(ArityMismatch(q.name, 0, args.length()))
          return PyAny
        }
        return PyVar(stub_name(q.name))
      }
      match self.map_builtin(q.name, args, depth) {
        Some(t) => t
        None =>
          if self.locals.contains(q.name) {
            let arity = self.locals.get(q.name).unwrap_or(-1)
            if arity < 0 {
              // Re-exported with unknown arity: usable bare, opaque if
              // instantiated.
              if args.length() > 0 {
                self.note(ArityMismatch(q.name, -1, args.length()))
                PyAny
              } else {
                PyHandle(stub_name(q.name), [])
              }
            } else if arity == args.length() {
              PyHandle(stub_name(q.name), self.map_args(args, depth))
            } else {
              self.note(ArityMismatch(q.name, arity, args.length()))
              PyAny
            }
          } else {
            self.unknown(q.name)
          }
      }
    }
  }
}

///|
fn Mapper::unknown(self : Mapper, name : String) -> PyType {
  self.note(UnknownType(name))
  PyAny
}

///|
/// The builtin table. `None` means "not a builtin", which falls through to the
/// local type table.
fn Mapper::map_builtin(
  self : Mapper,
  name : String,
  args : Array[@mbti.TypeExpr],
  depth : Int32,
) -> PyType? {
  match name {
    "Int"
    | "Int8"
    | "Int16"
    | "Int32"
    | "Int64"
    | "UInt"
    | "UInt8"
    | "UInt16"
    | "UInt32"
    | "UInt64"
    | "BigInt"
    | "Byte" => Some(PyInt)
    "Double" | "Float" => Some(PyFloat)
    "Bool" => Some(PyBool)
    // A `Char` is a code point; Python's nearest exact type is a 1-char `str`.
    "String" | "StringView" | "Char" => Some(PyStr)
    "Bytes" => Some(PyBytes)
    "Unit" => Some(PyNone)
    "Array" | "FixedArray" => self.one_arg(name, args, depth)
    "ArrayView" => self.one_arg(name, args, depth)
    "Option" =>
      if args.length() != 1 {
        self.note(ArityMismatch(name, 1, args.length()))
        Some(PyAny)
      } else {
        Some(PyOptional(self.map_at(args[0], depth + 1)))
      }
    "Result" =>
      if args.length() != 2 {
        self.note(ArityMismatch(name, 2, args.length()))
        Some(PyAny)
      } else {
        self.note(ResultErased)
        Some(self.map_at(args[0], depth + 1))
      }
    "Map" =>
      if args.length() != 2 {
        self.note(ArityMismatch(name, 2, args.length()))
        Some(PyAny)
      } else {
        Some(
          PyDict(
            self.map_at(args[0], depth + 1),
            self.map_at(args[1], depth + 1),
          ),
        )
      }
    _ => None
  }
}

///|
fn Mapper::one_arg(
  self : Mapper,
  name : String,
  args : Array[@mbti.TypeExpr],
  depth : Int32,
) -> PyType? {
  if args.length() != 1 {
    self.note(ArityMismatch(name, 1, args.length()))
    Some(PyAny)
  } else {
    let inner = self.map_at(args[0], depth + 1)
    Some(
      match name {
        // A view is read-only by construction, so `Sequence` is the honest
        // annotation: the caller may pass a tuple or a range, not just a list.
        "ArrayView" => PySeq(inner)
        _ => PyList(inner)
      },
    )
  }
}
