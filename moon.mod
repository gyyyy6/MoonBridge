// MoonBridge — generate Python bindings for MoonBit packages.
// Docs: https://docs.moonbitlang.com/en/latest/toolchain/moon/module.html

name = "gyyyy6/moonbridge"

version = "0.1.0"

source = "src"

readme = "README.md"

repository = "https://github.com/gyyyy6/MoonBridge"

license = "Apache-2.0"

keywords = [ "ffi", "bindings", "python", "interop", "codegen", "wasm" ]

description = "MoonBridge: generate installable Python packages from MoonBit modules, with typed stubs, GC-safe handles and a stable host ABI."

preferred_target = "wasm"
